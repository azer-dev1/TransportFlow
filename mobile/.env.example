# Copy to .env — these are the shared public keys of the LOCAL supabase stack
# (printed by `npx supabase start`), not real secrets.
#
# URL note per device target:
#   iOS simulator / web:      http://127.0.0.1:54321
#   Android emulator:         http://10.0.2.2:54321
#   physical device (Expo Go): http://<your-LAN-IP>:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
